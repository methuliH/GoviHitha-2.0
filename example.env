# GoviHitha — Example Environment Configuration
#
# This file documents the structure of the two env files the project needs.
# Copy the relevant section into the real file and fill in your own values.
# DO NOT commit real API keys or credentials — these are placeholders only.

# =====================================================================
# Backend — copy this section into a new file named `.env` at repo root
# =====================================================================

# Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Google Cloud project ID (used for Vertex AI fallback / Cloud Run deploy)
GOOGLE_CLOUD_PROJECT=your_gcp_project_id

# Google Cloud region for deployment
GOOGLE_CLOUD_REGION=us-central1

# Comma-separated list of allowed CORS origins for the FastAPI server
# (defaults to "*" in local dev; lock this down in production)
ALLOWED_ORIGINS=*


# ==========================================================================
# Frontend — copy this section into a new file named `.env.local` inside
# the `frontend/` directory
# ==========================================================================

# Option A — connect the frontend to a running Python backend:
AGENT_URL=http://localhost:8000

# Option B — run the frontend with per-crop demo data, no backend needed:
# MOCK_MODE=true

# AGENT_URL and MOCK_MODE are mutually exclusive; AGENT_URL takes
# precedence if both are set. Leave both unset and the app will return a
# clear "service not configured" error instead of silently faking a result.
